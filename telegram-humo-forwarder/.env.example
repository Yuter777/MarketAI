# Telegram API credentials (from https://my.telegram.org/apps)
API_ID=
API_HASH=

# Session string (generated via: npm run generate-session)
SESSION_STRING=

# Target bot token (the bot that will SEND forwarded messages)
TARGET_BOT_TOKEN=

# Target chat IDs (comma-separated for multiple receivers)
# Examples: -1001234567890 (group), 987654321 (user), @channelname
TARGET_CHAT_IDS=

# Source bot/user to listen to
SOURCE_CHAT=HUMOcardbot

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Reconnect settings
RECONNECT_DELAY_MS=5000
MAX_RECONNECT_ATTEMPTS=10
